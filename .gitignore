# a real fleet. This repo is PUBLIC; the README documents the shape with
# fictional devices instead.
/models/
# Vault definitions point at local paths (secrets themselves live in .swamp/).
/vaults/
/grants/
/workflows/
# .swamp.yaml carries repo-local state (repoId, and a datastore block if one is
# ever added, which names a bucket). Only the example is tracked.
.swamp.yaml
